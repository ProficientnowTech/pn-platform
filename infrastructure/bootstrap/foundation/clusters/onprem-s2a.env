# onprem-s2a — the PROVING target for the P2/P3/P4 target-cluster acceptance gate.
#
# WHY THIS CLUSTER AND NOT `onprem-primary`: the registry's onprem-primary is "the NEW cluster that
# replaces the interim onprem-s2a; redone for 3-node HA at node-C join" (docs/plans/PROGRESS.md).
# Node C is blocked on the Windows Server licensing escalation, so onprem-primary CANNOT be built yet —
# which would leave every P2/P3/P4 acceptance gate blocked behind a business decision.
#
# onprem-s2a is the right proving ground precisely because it is disposable: it carries zero PVs/PVCs by
# policy, and a full teardown -> ready-for-apps rebuild is a routine, measured operation (repeatedly
# verified against four gates: nodes Ready, all ArgoCD apps Synced+Healthy, ingress serving from the
# public internet, and a PVC that actually binds). Breaking it costs a rebuild, not an incident.
#
# So: prove the kapp foundation here FIRST, then build onprem-primary with machinery that has already
# met real hardware — instead of discovering the hardware-only defects during the real build.
CLUSTER_NAME=onprem-s2a

# Provided by P3's ephemeral bootstrapper at runtime (in-cluster address). Left at the P3 contract value:
# a P2-only acceptance run must either have P3 supply it, or point this at a reachable dev Vault. It is
# NOT a placeholder to be silently ignored — ESO's bootstrap ClusterSecretStore resolves against it.
EPHEMERAL_VAULT_ADDR=http://ephemeral-vault.bootstrap.svc:8200

# The live PVE API. Matches terraform/environments/onprem-k8s var.proxmox_endpoint on the proven stack:
# host D (founder, .131) — any quorate member proxies cluster-wide. Self-signed cert; the endpoint sits
# on the frozen management segment.
PVE_API_URL=https://192.168.100.131:8006/api2/json

# The CSI/CCM topology region. NOT a free-form label: proxmox-CSI stamps it into every volumeHandle and
# into the PV's nodeAffinity. Observed on the live cluster as `onprem-s2a/<pve-host>/local-zfs/vm-*-pvc-*`,
# i.e. region=onprem-s2a, zone=<PVE HOST>. Volumes are therefore PVE-HOST-local: a pod may move between
# k8s nodes sharing a host, never to a different host. Changing this value orphans existing volumes.
PVE_REGION=onprem-s2a
